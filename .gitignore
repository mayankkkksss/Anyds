# ==============================================================================
# Standard .gitignore — Anyds (Vite / React / TypeScript)
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production Builds
dist/
dist-ssr/
build/
out/

# Environment Variables & Local Settings
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# Caches & Diagnostics
.cache/
.vite/
.eslintcache
.stylelintcache
*.tsbuildinfo
.temp/
.tmp/

# Editor & IDE Directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Local Tooling & Scratch Artifacts
.aider-desk/
.aider*
# Playwright CLI output (may contain credentials)
.playwright-cli/
